# Server only. Never commit .env.local or share keys in a recording.
# Copy the exact API endpoint and key from your Hindsight account.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=recall

# Choose gemini, groq, or openai. Leave unused provider keys empty.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional explicit backup for Gemini, or primary when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Required for Gemini and Groq research; unused by OpenAI research.
TAVILY_API_KEY=

# Configure only when using OpenAI. Verify model access and capabilities.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_SEARCH_MODEL=

# Required for hosting: a private random secret, at least 24 characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Signs session cookies; does not encrypt their contents.
SESSION_SECRET=
